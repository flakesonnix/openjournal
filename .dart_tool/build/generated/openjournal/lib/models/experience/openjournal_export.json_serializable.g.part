OpenJournalExport _$OpenJournalExportFromJson(
  Map<String, dynamic> json,
) => OpenJournalExport(
  experiences:
      (json['experiences'] as List<dynamic>?)
          ?.map(
            (e) => ExperienceSerializable.fromJson(e as Map<String, dynamic>),
          )
          .toList() ??
      const [],
  substanceCompanions:
      (json['substanceCompanions'] as List<dynamic>?)
          ?.map((e) => SubstanceCompanion.fromJson(e as Map<String, dynamic>))
          .toList() ??
      const [],
  customSubstances:
      (json['customSubstances'] as List<dynamic>?)
          ?.map(
            (e) =>
                CustomSubstanceSerializable.fromJson(e as Map<String, dynamic>),
          )
          .toList() ??
      const [],
  customUnits:
      (json['customUnits'] as List<dynamic>?)
          ?.map(
            (e) => CustomUnitSerializable.fromJson(e as Map<String, dynamic>),
          )
          .toList() ??
      const [],
);

Map<String, dynamic> _$OpenJournalExportToJson(OpenJournalExport instance) =>
    <String, dynamic>{
      'experiences': instance.experiences,
      'substanceCompanions': instance.substanceCompanions,
      'customSubstances': instance.customSubstances,
      'customUnits': instance.customUnits,
    };

ExperienceSerializable _$ExperienceSerializableFromJson(
  Map<String, dynamic> json,
) => ExperienceSerializable(
  title: json['title'] as String,
  text: json['text'] as String,
  creationDate: DateTime.parse(json['creationDate'] as String),
  sortDate: DateTime.parse(json['sortDate'] as String),
  isFavorite: json['isFavorite'] as bool? ?? false,
  ingestions:
      (json['ingestions'] as List<dynamic>?)
          ?.map(
            (e) => IngestionSerializable.fromJson(e as Map<String, dynamic>),
          )
          .toList() ??
      const [],
  location: json['location'] == null
      ? null
      : Location.fromJson(json['location'] as Map<String, dynamic>),
  ratings:
      (json['ratings'] as List<dynamic>?)
          ?.map((e) => RatingSerializable.fromJson(e as Map<String, dynamic>))
          .toList() ??
      const [],
  timedNotes:
      (json['timedNotes'] as List<dynamic>?)
          ?.map(
            (e) => TimedNoteSerializable.fromJson(e as Map<String, dynamic>),
          )
          .toList() ??
      const [],
);

Map<String, dynamic> _$ExperienceSerializableToJson(
  ExperienceSerializable instance,
) => <String, dynamic>{
  'title': instance.title,
  'text': instance.text,
  'creationDate': instance.creationDate.toIso8601String(),
  'sortDate': instance.sortDate.toIso8601String(),
  'isFavorite': instance.isFavorite,
  'ingestions': instance.ingestions,
  'location': instance.location,
  'ratings': instance.ratings,
  'timedNotes': instance.timedNotes,
};

CustomSubstanceSerializable _$CustomSubstanceSerializableFromJson(
  Map<String, dynamic> json,
) => CustomSubstanceSerializable(
  id: (json['id'] as num?)?.toInt() ?? 0,
  name: json['name'] as String,
  units: json['units'] as String,
  description: json['description'] as String,
);

Map<String, dynamic> _$CustomSubstanceSerializableToJson(
  CustomSubstanceSerializable instance,
) => <String, dynamic>{
  'id': instance.id,
  'name': instance.name,
  'units': instance.units,
  'description': instance.description,
};

CustomUnitSerializable _$CustomUnitSerializableFromJson(
  Map<String, dynamic> json,
) => CustomUnitSerializable(
  id: (json['id'] as num?)?.toInt() ?? 0,
  substanceName: json['substanceName'] as String,
  name: json['name'] as String,
  creationDate: DateTime.parse(json['creationDate'] as String),
  administrationRoute: $enumDecode(
    _$AdministrationRouteEnumMap,
    json['administrationRoute'],
  ),
  dose: (json['dose'] as num?)?.toDouble(),
  estimatedDoseStandardDeviation:
      (json['estimatedDoseStandardDeviation'] as num?)?.toDouble(),
  isEstimate: json['isEstimate'] as bool,
  isArchived: json['isArchived'] as bool,
  unit: json['unit'] as String,
  unitPlural: json['unitPlural'] as String?,
  originalUnit: json['originalUnit'] as String,
  note: json['note'] as String,
);

Map<String, dynamic> _$CustomUnitSerializableToJson(
  CustomUnitSerializable instance,
) => <String, dynamic>{
  'id': instance.id,
  'substanceName': instance.substanceName,
  'name': instance.name,
  'creationDate': instance.creationDate.toIso8601String(),
  'administrationRoute':
      _$AdministrationRouteEnumMap[instance.administrationRoute]!,
  'dose': instance.dose,
  'estimatedDoseStandardDeviation': instance.estimatedDoseStandardDeviation,
  'isEstimate': instance.isEstimate,
  'isArchived': instance.isArchived,
  'unit': instance.unit,
  'unitPlural': instance.unitPlural,
  'originalUnit': instance.originalUnit,
  'note': instance.note,
};

const _$AdministrationRouteEnumMap = {
  AdministrationRoute.oral: 'oral',
  AdministrationRoute.sublingual: 'sublingual',
  AdministrationRoute.buccal: 'buccal',
  AdministrationRoute.insufflated: 'insufflated',
  AdministrationRoute.rectal: 'rectal',
  AdministrationRoute.transdermal: 'transdermal',
  AdministrationRoute.subcutaneous: 'subcutaneous',
  AdministrationRoute.intramuscular: 'intramuscular',
  AdministrationRoute.intravenous: 'intravenous',
  AdministrationRoute.smoked: 'smoked',
  AdministrationRoute.inhaled: 'inhaled',
};

RatingSerializable _$RatingSerializableFromJson(Map<String, dynamic> json) =>
    RatingSerializable(
      option: $enumDecode(_$ShulginRatingOptionEnumMap, json['option']),
      time: json['time'] == null
          ? null
          : DateTime.parse(json['time'] as String),
      creationDate: json['creationDate'] == null
          ? null
          : DateTime.parse(json['creationDate'] as String),
    );

Map<String, dynamic> _$RatingSerializableToJson(RatingSerializable instance) =>
    <String, dynamic>{
      'option': _$ShulginRatingOptionEnumMap[instance.option]!,
      'time': instance.time?.toIso8601String(),
      'creationDate': instance.creationDate?.toIso8601String(),
    };

const _$ShulginRatingOptionEnumMap = {
  ShulginRatingOption.minus: 'minus',
  ShulginRatingOption.plusMinus: 'plusMinus',
  ShulginRatingOption.plus: 'plus',
  ShulginRatingOption.twoPlus: 'twoPlus',
  ShulginRatingOption.threePlus: 'threePlus',
  ShulginRatingOption.fourPlus: 'fourPlus',
};

IngestionSerializable _$IngestionSerializableFromJson(
  Map<String, dynamic> json,
) => IngestionSerializable(
  substanceName: json['substanceName'] as String,
  time: DateTime.parse(json['time'] as String),

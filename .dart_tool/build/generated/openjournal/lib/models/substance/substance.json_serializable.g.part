// **************************************************************************
// JsonSerializableGenerator
// **************************************************************************

Substance _$SubstanceFromJson(Map<String, dynamic> json) => Substance(
  name: json['name'] as String,
  commonNames: (json['commonNames'] as List<dynamic>)
      .map((e) => e as String)
      .toList(),
  url: json['url'] as String,
  isApproved: json['isApproved'] as bool,
  tolerance: json['tolerance'] == null
      ? null
      : Tolerance.fromJson(json['tolerance'] as Map<String, dynamic>),
  crossTolerances: (json['crossTolerances'] as List<dynamic>)
      .map((e) => e as String)
      .toList(),
  addictionPotential: json['addictionPotential'] as String?,
  toxicities: (json['toxicities'] as List<dynamic>)
      .map((e) => e as String)
      .toList(),
  categories: (json['categories'] as List<dynamic>)
      .map((e) => e as String)
      .toList(),
  summary: json['summary'] as String?,
  effectsSummary: json['effectsSummary'] as String?,
  dosageRemark: json['dosageRemark'] as String?,
  generalRisks: json['generalRisks'] as String?,
  longtermRisks: json['longtermRisks'] as String?,
  saferUse: (json['saferUse'] as List<dynamic>)
      .map((e) => e as String)
      .toList(),
  interactions: json['interactions'] == null
      ? null
      : Interactions.fromJson(json['interactions'] as Map<String, dynamic>),
  roas: (json['roas'] as List<dynamic>)
      .map((e) => Roa.fromJson(e as Map<String, dynamic>))
      .toList(),
);

Map<String, dynamic> _$SubstanceToJson(Substance instance) => <String, dynamic>{
  'name': instance.name,
  'commonNames': instance.commonNames,
  'url': instance.url,
  'isApproved': instance.isApproved,
  'tolerance': instance.tolerance,
  'crossTolerances': instance.crossTolerances,
  'addictionPotential': instance.addictionPotential,
  'toxicities': instance.toxicities,
  'categories': instance.categories,
  'summary': instance.summary,
  'effectsSummary': instance.effectsSummary,
  'dosageRemark': instance.dosageRemark,
  'generalRisks': instance.generalRisks,
  'longtermRisks': instance.longtermRisks,
  'saferUse': instance.saferUse,
  'interactions': instance.interactions,
  'roas': instance.roas,
};
